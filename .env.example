# Copy to .env; run.py reads AGRIPLAN_ keys. Environment variables take precedence.
AGRIPLAN_MODE=demo
# For a provider supporting Chat Completions JSON mode:
# AGRIPLAN_MODE=llm
# AGRIPLAN_MODEL_BASE_URL=https://api.openai.com/v1
# AGRIPLAN_MODEL=your-enabled-model-name
# AGRIPLAN_MODEL_API_KEY=your-key
# Default password applies only when initializing a NEW database:
# AGRIPLAN_DEMO_PASSWORD=change-this-before-creating-a-database
# AGRIPLAN_DB=data/agriplan.db
